{
  "name": "fab-steel-viewer",
  "version": "1.0.0",
  "description": "FAB STEEL VIEWER - Windows app (FabSteel Structural Installer)",
  "author": "Fab steel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ir.fabsteel.viewer",
    "productName": "FAB STEEL VIEWER",
    "copyright": "FabSteel - programer eng davod bagheri",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "FAB STEEL VIEWER",
      "artifactName": "FabSteelViewer-Setup-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "fabsteel",
        "name": "FabSteel Project",
        "icon": "build/icon.ico"
      }
    ],
    "portable": {
      "artifactName": "FabSteelViewer-Portable-${version}.exe"
    }
  }
}